// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  TEXT
  IMAGE
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  password String

  sendChat    Chat[] @relation("send-chat")
  receiveChat Chat[] @relation("receive-chat")
}

model Chat {
  id         String      @id @default(uuid())
  senderId   String
  sender     User        @relation("send-chat", fields: [senderId], references: [id])
  receiverId String
  receiver   User        @relation("receive-chat", fields: [receiverId], references: [id])
  content    ContentType @default(TEXT)

  createdAt  DateTime    @default(now())     
  updatedAt  DateTime    @updatedAt          
}
